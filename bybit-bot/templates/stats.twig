{% extends "_layout.twig" %}
{% block title %}Результаты — Bybit Futures Bot{% endblock %}
{% block head %}
<style>
    nav { background:#222; padding:8px 20px; border-bottom:1px solid #333; font-size:13px; }
    nav a { color:#aab; text-decoration:none; margin-right:20px; }
    nav a:hover { color:#fff; }
    nav a.active { color:#6a9eff; font-weight:600; }

    .stats-grid { display:grid; grid-template-columns: 1fr 1fr; gap:16px; }
    @media (max-width: 920px) { .stats-grid { grid-template-columns: 1fr; } }

    table.stats-table { width:100%; border-collapse: collapse; font-size:12px; }
    table.stats-table th, table.stats-table td {
        padding:5px 8px; border-bottom:1px solid #2a2a2a; text-align:right;
    }
    table.stats-table th { background:#1c1c1c; color:#aab; text-align:right; font-weight:600; }
    table.stats-table th:first-child, table.stats-table td:first-child { text-align:left; }
    table.stats-table tbody tr:nth-child(odd)  { background:#1a1a1a; }
    table.stats-table tbody tr:nth-child(even) { background:#161616; }
    table.stats-table tfoot td { background:#222; color:#e0e0e0; font-weight:600; border-top:2px solid #333; }

    .pnl-pos { color:#6aff6a; }
    .pnl-neg { color:#ff6a6a; }
    .wr-good { color:#6aff6a; }
    .wr-bad  { color:#ff6a6a; }
    .wr-mid  { color:#ffcc44; }

    .totals-box {
        display:flex; flex-wrap:wrap; gap:18px;
        padding:10px 14px; background:#1a1a1a; border:1px solid #2a2a2a;
        border-radius:4px; margin-bottom:14px;
    }
    .totals-box .tb-item { display:flex; flex-direction:column; min-width:90px; }
    .totals-box .tb-label { font-size:11px; color:#779; }
    .totals-box .tb-value { font-size:15px; color:#e0e0e0; font-weight:600; }

    .chart-card { padding:10px 14px 14px; }
    .chart-card h3 { margin:0 0 8px 0; font-size:13px; color:#aab; font-weight:500; }

    .mode-filter { font-size:12px; margin-bottom:10px; }
    .mode-filter select { background:#1a1a1a; color:#e0e0e0; border:1px solid #333; padding:3px 6px; }

    /* v0.9.1: inline deposit editor */
    .dep-cell { white-space:nowrap; }
    .dep-val { cursor:pointer; border-bottom:1px dashed #446; }
    .dep-val:hover { color:#9bd; }
    .dep-edit-wrap { display:none; margin-top:4px; }
    .dep-edit-wrap.open { display:flex; gap:4px; align-items:center; }
    .dep-edit-wrap input[type=number] {
        width:90px; padding:2px 4px; font-size:11px;
        background:#111; border:1px solid #446; color:#e0e0e0; border-radius:3px;
    }
    .dep-save-btn { font-size:11px; padding:2px 6px; background:#1a3a5a; color:#9bd;
        border:1px solid #3a6a9a; border-radius:3px; cursor:pointer; }
    .dep-save-btn:hover { background:#204060; }
    .dep-cancel-btn { font-size:11px; padding:2px 4px; background:#2a2a2a; color:#779;
        border:1px solid #444; border-radius:3px; cursor:pointer; }
</style>
{% endblock %}
{% block body %}
<nav>
    <a href="/dashboard">Dashboard</a>
    <a href="/trades">Trades</a>
    <a href="/stats" class="active">Результаты</a>
    <a href="/events">События</a>
    <a href="/signals">Сигналы</a>
    <a href="/accounts">Аккаунты</a>
    <a href="/settings">Settings</a>
    <a href="/logout">Выйти</a>
</nav>
<header>
    <h1>Bybit Futures Bot — Результаты
        <span class="mode-badge mode-{{ mode }}">{{ mode }}</span>
    </h1>
    <div class="right"><span style="color:#666;">v{{ app_version }}</span></div>
</header>
<main>

<div class="card">
    <form method="GET" action="/stats" class="mode-filter">
        <label>Режим:
            <select name="mode" onchange="this.form.submit()">
                <option value="paper"   {{ filter_mode == 'paper'   ? 'selected' : '' }}>paper</option>
                <option value="testnet" {{ filter_mode == 'testnet' ? 'selected' : '' }}>testnet</option>
                <option value="live"    {{ filter_mode == 'live'    ? 'selected' : '' }}>live</option>
            </select>
        </label>
        {# v0.9.0-step7 task6: фильтр по аккаунту #}
        <label style="margin-left:14px;">Аккаунт:
            <select name="account" onchange="this.form.submit()">
                <option value="" {{ filter_account is null ? 'selected' : '' }}>— все —</option>
                {% for a in all_accounts %}
                    <option value="{{ a.id }}" {{ filter_account == a.id ? 'selected' : '' }}>#{{ a.id }} · {{ a.name }}</option>
                {% endfor %}
            </select>
        </label>
        <span style="color:#666;margin-left:10px;">D0 = {{ d0|number_format(2) }} USDT</span>
        <button type="button" id="btn-backfill-snapshots"
                style="margin-left:14px;background:#1a1a1a;color:#9bd;border:1px solid #335;
                       padding:3px 10px;cursor:pointer;font-size:12px;"
                title="Полный пересчёт всех equity_snapshots из истории сделок">
            Пересчитать snapshots
        </button>
        <span id="backfill-status" style="color:#779;margin-left:8px;font-size:11px;"></span>
    </form>

    {# ── Итого за всё время ── #}
    {% if totals and totals.trades_count > 0 %}
    <div class="totals-box">
        <div class="tb-item">
            <span class="tb-label">Сделок</span>
            <span class="tb-value">{{ totals.trades_count }}</span>
        </div>
        <div class="tb-item">
            <span class="tb-label">Win / Loss</span>
            <span class="tb-value">
                <span class="pnl-pos">{{ totals.wins }}</span> /
                <span class="pnl-neg">{{ totals.losses }}</span>
            </span>
        </div>
        <div class="tb-item">
            <span class="tb-label">Win rate</span>
            {% set wr = totals.win_rate %}
            {% set wcls = wr >= 60 ? 'wr-good' : (wr >= 40 ? 'wr-mid' : 'wr-bad') %}
            <span class="tb-value {{ wcls }}">{{ wr|number_format(1) }}%</span>
        </div>
        <div class="tb-item">
            <span class="tb-label">Gross profit</span>
            <span class="tb-value pnl-pos">+{{ totals.gross_profit|number_format(2) }}</span>
        </div>
        <div class="tb-item">
            <span class="tb-label">Gross loss</span>
            <span class="tb-value pnl-neg">{{ totals.gross_loss|number_format(2) }}</span>
        </div>
        <div class="tb-item">
            <span class="tb-label">Net PnL</span>
            <span class="tb-value {{ totals.net_pnl >= 0 ? 'pnl-pos' : 'pnl-neg' }}">
                {{ totals.net_pnl >= 0 ? '+' : '' }}{{ totals.net_pnl|number_format(2) }}
            </span>
        </div>
    </div>
    {% else %}
    <p style="color:#779;font-size:12px;">Закрытых сделок в режиме <strong>{{ filter_mode }}</strong> пока нет.</p>
    {% endif %}

    {# ── График equity ── #}
    <div class="chart-card">
        <h3>Кривая equity (накопленный realized PnL + D0)</h3>
        {{ equity_svg|raw }}
    </div>
</div>

<div class="stats-grid">
    {# ── По неделям ── #}
    <div class="card">
        <h3 style="margin:0 0 10px 0;font-size:13px;color:#aab;">По неделям (последние 26)</h3>
        {% if weekly|length > 0 %}
        <table class="stats-table">
            <thead>
                <tr>
                    <th>Неделя</th>
                    <th>Депозит начало</th>
                    <th>Сделок</th>
                    <th>W/L</th>
                    <th>WR%</th>
                    <th>Net PnL</th>
                </tr>
            </thead>
            <tbody>
                {% for r in weekly %}
                <tr>
                    <td>{{ r.period_label is not empty ? r.period_label : r.period }}</td>
                    <td class="dep-cell"
                        data-mode="{{ filter_mode }}"
                        data-account="{{ filter_account ?? '' }}"
                        data-period-type="week"
                        data-period-start="{{ r.period_start_mon }}">
                        {% if r.deposit_start_available %}
                            <span class="dep-val" title="Нажмите, чтобы изменить вручную">{{ r.deposit_start|number_format(2) }}</span>
                        {% else %}
                            <span class="dep-val" title="Нажмите, чтобы задать вручную" style="color:#555;">—</span>
                        {% endif %}
                        <div class="dep-edit-wrap">
                            <input type="number" step="0.01" min="0.01"
                                   value="{{ r.deposit_start_available ? r.deposit_start : '' }}"
                                   placeholder="USDT">
                            <button class="dep-save-btn">Сохранить</button>
                            <button class="dep-cancel-btn">✕</button>
                        </div>
                    </td>
                    <td>{{ r.trades_count }}</td>
                    <td><span class="pnl-pos">{{ r.wins }}</span>/<span class="pnl-neg">{{ r.losses }}</span></td>
                    {% set wr = r.win_rate %}
                    {% set wcls = wr >= 60 ? 'wr-good' : (wr >= 40 ? 'wr-mid' : 'wr-bad') %}
                    <td class="{{ wcls }}">{{ wr|number_format(1) }}</td>
                    <td class="{{ r.net_pnl >= 0 ? 'pnl-pos' : 'pnl-neg' }}">
                        {{ r.net_pnl >= 0 ? '+' : '' }}{{ r.net_pnl|number_format(2) }} USDT
                        {% if r.deposit_start_available %}
                        <span style="font-size:11px;opacity:0.85;">
                            ({{ r.pnl_pct >= 0 ? '+' : '' }}{{ r.pnl_pct|number_format(2) }}%)
                        </span>
                        {% endif %}
                    </td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
        {% else %}
        <p style="color:#666;font-size:12px;">Нет данных.</p>
        {% endif %}
    </div>

    {# ── По месяцам ── #}
    <div class="card">
        <h3 style="margin:0 0 10px 0;font-size:13px;color:#aab;">По месяцам (последние 24)</h3>
        {% if monthly|length > 0 %}
        <table class="stats-table">
            <thead>
                <tr>
                    <th>Месяц</th>
                    <th>Депозит начало</th>
                    <th>Сделок</th>
                    <th>W/L</th>
                    <th>WR%</th>
                    <th>Net PnL</th>
                </tr>
            </thead>
            <tbody>
                {% for r in monthly %}
                <tr>
                    <td>{{ r.period_label is not empty ? r.period_label : r.period }}</td>
                    <td class="dep-cell"
                        data-mode="{{ filter_mode }}"
                        data-account="{{ filter_account ?? '' }}"
                        data-period-type="month"
                        data-period-start="{{ r.period_start_first }}">
                        {% if r.deposit_start_available %}
                            <span class="dep-val" title="Нажмите, чтобы изменить вручную">{{ r.deposit_start|number_format(2) }}</span>
                        {% else %}
                            <span class="dep-val" title="Нажмите, чтобы задать вручную" style="color:#555;">—</span>
                        {% endif %}
                        <div class="dep-edit-wrap">
                            <input type="number" step="0.01" min="0.01"
                                   value="{{ r.deposit_start_available ? r.deposit_start : '' }}"
                                   placeholder="USDT">
                            <button class="dep-save-btn">Сохранить</button>
                            <button class="dep-cancel-btn">✕</button>
                        </div>
                    </td>
                    <td>{{ r.trades_count }}</td>
                    <td><span class="pnl-pos">{{ r.wins }}</span>/<span class="pnl-neg">{{ r.losses }}</span></td>
                    {% set wr = r.win_rate %}
                    {% set wcls = wr >= 60 ? 'wr-good' : (wr >= 40 ? 'wr-mid' : 'wr-bad') %}
                    <td class="{{ wcls }}">{{ wr|number_format(1) }}</td>
                    <td class="{{ r.net_pnl >= 0 ? 'pnl-pos' : 'pnl-neg' }}">
                        {{ r.net_pnl >= 0 ? '+' : '' }}{{ r.net_pnl|number_format(2) }} USDT
                        {% if r.deposit_start_available %}
                        <span style="font-size:11px;opacity:0.85;">
                            ({{ r.pnl_pct >= 0 ? '+' : '' }}{{ r.pnl_pct|number_format(2) }}%)
                        </span>
                        {% endif %}
                    </td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
        {% else %}
        <p style="color:#666;font-size:12px;">Нет данных.</p>
        {% endif %}
    </div>
</div>

</main>
<script>
(function(){
    var snapStatus = document.getElementById('backfill-status');

    function postJson(url, body) {
        return fetch(url, {
            method: 'POST',
            credentials: 'same-origin',
            headers: {'Content-Type': 'application/json'},
            body: JSON.stringify(body)
        }).then(function(r){ return r.json(); });
    }

    function setStatus(msg, color) {
        if (snapStatus) { snapStatus.textContent = msg; snapStatus.style.color = color || '#779'; }
    }

    // ── Полный пересчёт snapshots ──
    var btnBackfill = document.getElementById('btn-backfill-snapshots');
    if (btnBackfill) {
        btnBackfill.addEventListener('click', function(){
            if (!confirm('Пересчитать snapshots из истории сделок? Это перезапишет все записи equity_snapshots.')) return;
            btnBackfill.disabled = true;
            setStatus('Работаю…', '#aaa');
            postJson('/stats/backfill-snapshots', {})
                .then(function(j){
                    if (j && j.ok) {
                        setStatus('ОК, записано: ' + (j.written|0), '#9bd');
                        setTimeout(function(){ location.reload(); }, 800);
                    } else {
                        setStatus('Ошибка: ' + (j && j.error ? j.error : 'unknown'), '#f88');
                        btnBackfill.disabled = false;
                    }
                })
                .catch(function(e){ setStatus('Ошибка: ' + e, '#f88'); btnBackfill.disabled = false; });
        });
    }

    // ── Инлайн-редактирование начального депозита ──
    document.querySelectorAll('.dep-cell').forEach(function(cell){
        var valSpan  = cell.querySelector('.dep-val');
        var editWrap = cell.querySelector('.dep-edit-wrap');
        var input    = cell.querySelector('input[type=number]');
        var saveBtn  = cell.querySelector('.dep-save-btn');
        var cancelBtn= cell.querySelector('.dep-cancel-btn');
        if (!valSpan || !editWrap) return;

        valSpan.addEventListener('click', function(){
            editWrap.classList.add('open');
            if (input) input.focus();
        });

        if (cancelBtn) {
            cancelBtn.addEventListener('click', function(){
                editWrap.classList.remove('open');
            });
        }

        if (saveBtn && input) {
            saveBtn.addEventListener('click', function(){
                var val = parseFloat(input.value);
                if (!val || val <= 0) { input.style.borderColor = '#f66'; return; }
                input.style.borderColor = '';
                saveBtn.disabled = true;
                saveBtn.textContent = '…';
                var payload = {
                    mode:         cell.dataset.mode,
                    account_id:   cell.dataset.account || null,
                    period_type:  cell.dataset.periodType,
                    period_start: cell.dataset.periodStart,
                    deposit_usdt: val
                };
                postJson('/stats/set-deposit', payload)
                    .then(function(j){
                        if (j && j.ok) {
                            valSpan.textContent = val.toFixed(2);
                            editWrap.classList.remove('open');
                            setStatus('Баланс обновлён → ' + val.toFixed(2) + ' USDT', '#8d8');
                            setTimeout(function(){ location.reload(); }, 600);
                        } else {
                            setStatus('Ошибка: ' + (j && j.error ? j.error : 'unknown'), '#f88');
                            saveBtn.disabled = false;
                            saveBtn.textContent = 'Сохранить';
                        }
                    })
                    .catch(function(e){
                        setStatus('Ошибка: ' + e, '#f88');
                        saveBtn.disabled = false;
                        saveBtn.textContent = 'Сохранить';
                    });
            });
        }
    });
})();
</script>
{% endblock %}
