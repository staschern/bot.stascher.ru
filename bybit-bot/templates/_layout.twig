<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}Bybit Futures Bot{% endblock %}</title>
    {# v0.8.0.13: favicon — Bybit-style bull #}
    <link rel="icon" type="image/x-icon" href="/favicon.ico">
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png">
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
    <style>
        * { box-sizing: border-box; }
        body {
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
            background: #1a1a1a;
            color: #e0e0e0;
            margin: 0;
            padding: 0;
        }
        header {
            background: #2a2a2a;
            padding: 12px 20px;
            border-bottom: 1px solid #3a3a3a;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
        header h1 { margin: 0; font-size: 18px; font-weight: 500; }
        header .right { display: flex; gap: 16px; align-items: center; font-size: 13px; }
        header .right a { color: #aab; text-decoration: none; }
        header .right a:hover { color: #fff; }
        .mode-badge {
            display: inline-block;
            padding: 3px 10px;
            border-radius: 4px;
            font-size: 12px;
            font-weight: 600;
            text-transform: uppercase;
        }
        .mode-paper   { background: #2d4a8a; color: #c0d4ff; }
        .mode-testnet { background: #8a6d2d; color: #ffe5b8; }
        .mode-live    { background: #8a2d2d; color: #ffc0c0; }
        main { padding: 24px; max-width: 1280px; margin: 0 auto; }
        .card {
            background: #2a2a2a;
            border: 1px solid #3a3a3a;
            border-radius: 8px;
            padding: 20px;
            margin-bottom: 16px;
        }
        .placeholder { opacity: 0.6; font-style: italic; }
        h2 { margin: 0 0 12px 0; font-size: 16px; font-weight: 500; color: #aab; }
    </style>
    {% block head %}{% endblock %}
</head>
<body>
{% block body %}{% endblock %}
</body>
</html>
