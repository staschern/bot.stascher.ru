# Bybit Futures Bot — пример конфигурации окружения
# Скопируйте в .env и заполните значения. Никогда не коммитьте .env.

APP_ENV=production
APP_DEBUG=false
APP_TIMEZONE=Europe/Moscow

# Режим по умолчанию (paper|testnet|live). Переопределяется в БД-настройках.
APP_MODE=paper

# Пути (абсолютные на VPS)
DB_PATH=/var/www/www-root/data/www/stascher.ru/bybit-bot/data/bot.db
SECRETS_DIR=/var/www/www-root/data/www/stascher.ru/bybit-bot/data/secrets
SIGNALS_SOURCE_PATH=/var/www/www-root/data/www/stascher.ru/finManager/shared/signalsHourly.json
SIGNALS_LOCAL_DIR=/var/www/www-root/data/www/stascher.ru/bybit-bot/data/signals
LOGS_DIR=/var/www/www-root/data/www/stascher.ru/bybit-bot/logs

# Bybit API URLs
BYBIT_BASE_URL_MAINNET=https://api.bybit.com
BYBIT_BASE_URL_TESTNET=https://api-testnet.bybit.com
BYBIT_RECV_WINDOW=5000

# Bybit API ключи
# Используйте testnet ключи для paper/testnet режима (settings.mode = paper|testnet),
# mainnet ключи — только для live (settings.mode = live).
BYBIT_API_KEY_TESTNET=
BYBIT_API_SECRET_TESTNET=
BYBIT_API_KEY_MAINNET=
BYBIT_API_SECRET_MAINNET=

# Логировать тело каждого Bybit-запроса в api_calls (увеличит размер БД, по умолчанию false).
BYBIT_DEBUG_LOG=false

# Telegram (опционально, можно оставить пустым)
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Сессии
SESSION_TTL_HOURS=8
SESSION_IDLE_HOURS=1
